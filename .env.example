# Copy this file to .env and fill in your own keys. Never commit .env.

# --- LLM: primary ---
# Free tier, no card required. https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high. Low protects the tokens-per-minute free tier limit.
GROQ_REASONING_EFFORT=low

# --- LLM: fallback (switch with LLM_PROVIDER=gemini) ---
# Free tier. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional extra keys from other Google accounts, up to GEMINI_API_KEY_9.
# When one key is rate limited or out for the day, calls move to the next.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.5-flash-lite

# Which model answers. Measured on the same five turn booking call:
#   groq    median 46s, max 69s  (stalls on an 8000 tokens/minute cap)
#   gemini  median 3.25s, max 10.2s
# Groq is faster per request but the free tier cannot carry a tool heavy
# conversation. Gemini is the default for that reason. See the engineering log.
LLM_PROVIDER=gemini

# Models tried in order when the one before is out of quota or unavailable.
# Each Gemini model has its own free tier quota of requests per day.
# Groq goes last: fast per request, but its tokens per minute cap is soon
# reached in a long call. Set to none to use the primary model alone.
LLM_FALLBACKS=gemini:gemini-3-flash-preview,gemini:gemini-3.1-flash-lite,groq:openai/gpt-oss-120b

# --- Speech to text and text to speech (needed from Day 4 only) ---
# Free signup credit, no card required. https://console.deepgram.com
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=en-GB
# British voices: aura-2-pandora-en, aura-athena-en,
#                 aura-2-draco-en, aura-helios-en
DEEPGRAM_TTS_VOICE=aura-2-pandora-en
# Aura-2 voices only, 0.7 to 1.5.
DEEPGRAM_TTS_SPEED=1.0

# --- Sophia's voice, optionally from Cartesia (free tier, no card) ---
# https://play.cartesia.ai. Choose a voice by listening:
#   python scripts/voice_samples.py
TTS_PROVIDER=deepgram
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.6
# How she speaks: speed 0.6 to 1.5, emotion such as calm or content. Empty = default.
CARTESIA_SPEED=
CARTESIA_EMOTION=

# --- Runtime ---
TIMEZONE=Europe/London
SOPHIA_DB_PATH=data/sophia.db
# Demo only: new patients may give made up postcodes and phone numbers.
# Existing patients are always checked against their record. false = UK formats.
SOPHIA_DEMO_DETAILS=true
LOG_LEVEL=INFO

# --- WebRTC relay (only needed so OTHER PEOPLE can call, not just you) ---
# WebRTC audio is peer to peer. Without a relay, a call works between a
# browser and a server on the SAME machine and nowhere else, because a
# caller on another network has no route to your machine behind its
# router. This is not a firewall you can turn off, it is how NAT works.
#
# Free: sign up at https://dashboard.metered.ca/signup?tool=turnserver
# (no card, 20 GB a month). Take the app name and the API key.
# The app name is the first part of yourappname.metered.live
METERED_APP_NAME=
METERED_API_KEY=

# Or point at any other TURN provider directly. If these are set they win.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
