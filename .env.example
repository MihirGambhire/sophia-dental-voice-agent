# Copy this file to .env and fill in your own keys. Never commit .env.

# --- LLM: primary ---
# Free tier, no card required. https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- LLM: fallback (switch with LLM_PROVIDER=gemini) ---
# Free tier. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# groq | gemini
LLM_PROVIDER=groq

# --- Speech to text and text to speech (needed from Day 4 only) ---
# Free signup credit, no card required. https://console.deepgram.com
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=en-GB
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# --- Runtime ---
TIMEZONE=Europe/London
SOPHIA_DB_PATH=data/sophia.db
LOG_LEVEL=INFO
